  },
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "typecheck": "tsc -p ../.. --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ancientvoid/adapter-dummy": "0.1.0",
    "@ancientvoid/contracts": "0.1.0",
    "@ancientvoid/core": "0.1.0",
    "@ancientvoid/loop-ralph-hub": "0.1.0",
    "@ancientvoid/workers": "0.1.0",
    "@fastify/static": "^10.1.4",
    "@fastify/websocket": "^11.3.7",
    "@simplewebauthn/server": "^14.1.0",
    "fastify": "^5.12.5",
    "ws": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ancientvoid/adapter-testkit": "0.1.0",
    "@ancientvoid/loop-securesight-factory": "0.1.0",
    "fflate": "^0.8.3"
  }
}
