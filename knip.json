{
  "$schema": "https://unpkg.com/knip@6.45.1/schema.json",
  "ignore": [
    "apps/pwa/public/**",
    "scripts/fixtures/check-i18n/*.tsx",
    "scripts/fixtures/check-i18n-keys/*.tsx",
    "e2e/fixtures/ds-probe/DsProbe.tsx"
  ],
  "ignoreUnresolved": [
    "scripts/hub.sh"
  ],
  "ignoreBinaries": [
    "adb",
    "chromium",
    "codex",
    "dsh",
    "ffmpeg",
    "foot",
    "mosquitto",
    "mosquitto_passwd",
    "opencode",
    "rg",
    "script",
    "tesseract",
    "wl-copy",
    "yt-dlp"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.{mjs,ts,cjs,sh,mts,d.mts}",
        "e2e/**/*.ts",
        "playwright.live.config.ts",
        "examples/**/*.{ts,mjs}",
        "e2e/support/ralph-agent.mjs"
      ]
    },
    "apps/pwa": {
      "ignoreDependencies": [
        "@fontsource/*"
      ]
    },
    "apps/hub": {
      "entry": [
        "test/fixtures/**"
      ],
      "ignoreDependencies": [
        "@ancientvoid/loop-ralph-hub"
      ]
    }
  }
}
